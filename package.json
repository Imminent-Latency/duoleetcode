{
  "name": "duoleetcode-poc",
  "private": true,
  "type": "module",
  "scripts": {
    "leetcode:extension": "node spikes/leetcode/tools/prepare-extension.mjs",
    "leetcode:test": "node --test spikes/leetcode/tests/*.test.mjs",
    "leetcode:serve": "node spikes/leetcode/server.mjs",
    "leetcode:probe": "node spikes/leetcode/probe.mjs",
    "java:prepare": "node spikes/java-browser/tools/prepare.mjs",
    "java:serve": "node spikes/java-browser/tools/serve.mjs",
    "java:probe": "node spikes/java-browser/tools/probe.mjs",
    "dev": "node tools/prepare-app.mjs && node tools/practice-server.mjs dev",
    "build": "node tools/prepare-app.mjs && next build",
    "start": "node tools/practice-server.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "agent:smoke": "tsx tools/agent-smoke.ts",
    "dev:test": "node tools/prepare-app.mjs && node tools/practice-server.mjs test",
    "practice:backup": "node tools/practice-server.mjs backup",
    "practice:restore": "node tools/practice-server.mjs restore"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nspell": "^2.1.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.7",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mantine/core": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "@monaco-editor/loader": "^1.7.0",
    "dictionary-en": "^4.0.0",
    "dompurify": "^3.4.17",
    "idb": "^8.0.4",
    "lucide-react": "^1.69.0",
    "monaco-editor": "^0.57.0",
    "next": "^16.4.5",
    "nspell": "^2.1.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    }
  }
}
