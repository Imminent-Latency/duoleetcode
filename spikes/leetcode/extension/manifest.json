{
  "manifest_version": 3,
  "name": "DuoLeetCode Local Bridge",
  "version": "0.1.7",
  "description": "Use your existing LeetCode session from DuoLeetCode without opening LeetCode tabs or exporting login cookies.",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "key": "",
  "permissions": [
    "cookies",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://leetcode.com/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://leetcode.com"
  }
}
